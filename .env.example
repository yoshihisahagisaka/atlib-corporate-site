# ローカル開発用。本番はCloud Runの --set-secrets / --set-env-vars で注入する。

NODE_ENV=development
PORT=8080
GCP_PROJECT_ID=atlib-corporate-site

# Google Workspace SMTPリレー（msp-customer-portalと同じ構成: 587 + STARTTLS）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@atlib.jp
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@atlib.jp

# confirm→send のステートレスフォームトークン署名用シークレット（ランダムな長い文字列）
FORM_HMAC_SECRET=change-me

# 通知先（カンマ区切りで複数可）。未指定時は元PHPと同じデフォルト値を使う。
CONTACT_NOTIFY_EMAIL=contact@atlib.jp, database@atlib.jp
ENTRY_NOTIFY_EMAIL=contact@atlib.jp, database@atlib.jp

# 新コーポレートサイト /api/contact（未設定時は503、旧フォームは継続）
# SITE_CONTACT_TURNSTILE_SECRET は Cloud Run の --set-secrets で注入する。
SITE_CONTACT_TURNSTILE_SECRET=
# HTTPS originを完全一致指定。初期テスト用と正式公開用を明示的に列挙する。
SITE_CONTACT_ALLOWED_ORIGINS=
# Turnstile Siteverifyが返す hostname（スキーム不要、ワイルドカード不可）
SITE_CONTACT_TURNSTILE_HOSTNAMES=
